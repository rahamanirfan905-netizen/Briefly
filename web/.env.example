# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/briefly?schema=public"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required to seed an administrator
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-password-of-at-least-10-characters"

# Optional news providers and AI summaries
GNEWS_API_KEY=""
GUARDIAN_API_KEY=""
NEWSAPI_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Application and scheduled refresh
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-random-cron-secret"
ENABLE_INTERNAL_CRON="false"
REFRESH_INTERVAL_MINUTES="30"
